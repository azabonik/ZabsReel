{
  "name": "zedmix-desktop",
  "version": "0.2.0",
  "description": "Electron + React desktop UI for ZedMix. Shows the timeline, clip library and preview; reflects AI edits live.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "author": "Zabs",
  "main": "electron/main.cjs",
  "scripts": {
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:renderer && electron .",
    "dev:renderer": "vite",
    "electron": "electron .",
    "web": "node web/server.cjs",
    "prepare:bundle": "node scripts/prepare-bundle.ts",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@aive/core": "*",
    "@aive/mcp": "*",
    "@aive/motion": "*",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.11.12",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "io.github.azabonik.zedmix",
    "productName": "ZedMix",
    "publish": [
      {
        "provider": "github",
        "owner": "azabonik",
        "repo": "ZedMix"
      }
    ],
    "copyright": "Copyright © 2026 Relo. Modifications copyright © 2026 Zabs and the ZedMix contributors.",
    "electronVersion": "42.11.12",
    "npmRebuild": false,
    "asar": false,
    "directories": {
      "output": "build/dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!**/node_modules/@aive/core/src{,/**}",
      "!**/packages/core/src{,/**}",
      "!**/node_modules/@aive/motion/{parity,scripts,cleanroom/test}{,/**}",
      "!**/packages/motion/{parity,scripts,cleanroom/test}{,/**}"
    ],
    "extraResources": [
      {
        "from": "build/resources/aive",
        "to": "aive"
      },
      {
        "from": "../../THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      }
    ],
    "afterPack": "build/afterpack.cjs",
    "afterAllArtifactBuild": "build/afterbuild.cjs",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "ZedMix-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZedMix",
      "uninstallDisplayName": "ZedMix",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  }
}
